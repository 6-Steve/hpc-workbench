# 依赖与构建产物
node_modules/
out/
dist/
release/
*.log
npm-debug.log*

# npm 缓存（这台机器上默认缓存目录不可写，改到项目内）
.npm-cache/
# vitest / vite 的编译缓存
.vite-cache/
# 临时脚本与日志
.tmp/

# 本地配置：含主机地址、用户名、密钥路径，绝不提交
config/profiles.json
# 凭据保险库：里面是**密文**，但仍然不提交——
# 一是密文只在本机本账户下能解开，提交了没用；二是提交了等于泄露
# "这个账号有几个密码、什么时候改过"这些元信息
config/credentials.json
# 主机指纹与能力探测缓存，属于本机状态，不进仓库
config/known_hosts.json
config/.cache/
.env
.env.*

# 内部留存：原始采集样本，含真实节点名/用户名/文件系统名，绝不提交
internal/

# 背景材料：含实验室标识与集群细节，仅本地参考，不提交
reference/

# 系统文件
.DS_Store
Thumbs.db

# 工具目录（工作记忆、会话缓存），不入库
.workbuddy/

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/

# 界面偏好（关窗策略等），属于本机状态
config/ui.json

# 截图脚本的侧写诊断（每张 PNG 旁边会生成一个同名 .txt）
docs/screenshots/*.txt
